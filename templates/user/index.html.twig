{% extends 'base.html.twig' %}

{% block title %}equipos en stock{% endblock %}

{% block body %}
    <main class="catalog">
        <section class="hero" aria-labelledby="catalog-title">
            <div class="logo-slot" aria-label="Espacio para tu logo">
                {# Reemplazá este bloque por: <img src="{{ asset('images/tu-logo.png') }}" alt="Nombre de tu tienda"> #}
                <span>TU<br>LOGO</span>
            </div>
            <p class="eyebrow">Catálogo actualizado</p>
            <h1 id="catalog-title">equipos en stock</h1>
            <p class="intro">Elegí tu próximo iPhone. Consultanos para recibir precio, medios de pago y envío.</p>
            <a class="contact-button" href="https://instagram.com/" target="_blank" rel="noreferrer">Consultar por Instagram <span aria-hidden="true">↗</span></a>
        </section>

        <section class="inventory" aria-labelledby="inventory-title">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Stock</p>
                    <h2 id="inventory-title">Modelos</h2>
                </div>
                <span class="stock-note"><i></i> Actualizado hoy</span>
            </div>

            <div class="phone-list">
                {% for phone in phones %}
                    <article class="phone-card {{ phone.available ? '' : 'is-sold-out' }}">
                        <div class="phone-icon" aria-hidden="true"><span></span></div>
                        <div class="phone-info">
                            <h3>{{ phone.name }}</h3>
                            <p>{{ phone.storage }} · {{ phone.color }}</p>
                        </div>
                        <span class="status {{ phone.available ? 'available' : 'sold-out' }}">
                            {{ phone.available ? 'Disponible' : 'Agotado' }}
                        </span>
                    </article>
                {% endfor %}
            </div>
        </section>

        <footer>Escribinos por Instagram para reservar el tuyo.</footer>
    </main>
{% endblock %}
